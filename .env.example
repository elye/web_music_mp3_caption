# Optional tuning. No API keys are used. The app binds only to 127.0.0.1.
PORT=3001
# The selected model normally comes from pnpm setup:local --model small.
# Only already-downloaded models are accepted. No runtime downloads.
# LOCAL_WHISPER_MODEL=small
# CPU threads for transcription and vocal removal.
LOCAL_WHISPER_THREADS=4
# Maximum CPU processing time per six-minute audio chunk (20 minutes by default).
LOCAL_WHISPER_TIMEOUT_SECONDS=1200
# Optional existing Python environment with server/requirements-local.txt installed.
# LOCAL_WHISPER_PYTHON=/absolute/path/to/python
# Maximum CPU processing time to remove the vocals from one song (30 minutes by default).
LOCAL_SEPARATION_TIMEOUT_SECONDS=1800
